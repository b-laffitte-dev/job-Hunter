{
  "name": "job-hunter-ai",
  "version": "0.2.0",
  "description": "Chat IA de recherche d'emploi avec recherche web intégrée (Mistral Agents API)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "job-hunter-ai": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "serve": "tsx src/index.ts --serve",
    "serve:prod": "node dist/index.js --serve",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "job",
    "search",
    "llm",
    "ai",
    "chat",
    "france"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^18.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^5.0.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
