{
  "name": "job-hunter-ai",
  "version": "0.1.0",
  "description": "Agent IA de recherche d'emploi (scraping FR, mots-clés + scoring LLM) - 100% interactif avec IHM chat",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "job-hunter-ai": "dist/index.js"
  },
  "scripts": {
    "build": "npm run gen:ui && tsc",
    "bundle": "npm run gen:ui && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/job-hunter-ai.cjs --external:puppeteer",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "run:once": "tsx src/index.ts --once",
    "serve": "tsx src/index.ts --serve",
    "serve:prod": "node dist/index.js --serve",
    "typecheck": "tsc --noEmit",
    "gen:ui": "node scripts/gen-ui-assets.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "puppeteer:install": "npx puppeteer browsers install chromedriver@latest",
    "puppeteer:install-chrome": "npx puppeteer browsers install chrome-headless-shell@stable",
    "postinstall": "npm run puppeteer:install || echo 'Puppeteer browser installation can be done manually with: npm run puppeteer:install'"
  },
  "keywords": [
    "job",
    "scraper",
    "llm",
    "automation",
    "france"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.1",
    "fast-levenshtein": "^3.0.0",
    "jsdom": "^30.1.0",
    "puppeteer": "^25.11.0",
    "undici": "^8.10.2",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
