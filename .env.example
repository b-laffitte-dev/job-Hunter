# === LLM (Mistral par défaut, compatible OpenAI) ===
# Rendez-vous sur https://console.mistral.ai/api-keys
LLM_API_KEY=your_mistral_api_key
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest

# === France Travail (API officielle Pole Emploi) ===
# https://pole-emploi.io/inscription
FT_CLIENT_ID=your_francetravail_client_id
FT_CLIENT_SECRET=your_francetravail_client_secret

# Optionnel : activer puppeteer pour sites dynamiques (LinkedIn/Welcome)
ENABLE_PUPPETEER=false

# === Interface de chat ===
SERVE_PORT=3000
SERVE_HOST=127.0.0.1
