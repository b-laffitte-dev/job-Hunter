# Configuration pour Job Hunter AI (Chat Full IA avec Mistral Agents API)

# Clé API Mistral (obligatoire)
# Obtenez votre clé API sur https://console.mistral.ai
MISTRAL_API_KEY=votre_cle_api_mistral

# Ou utilisez LLM_API_KEY (alias)
LLM_API_KEY=votre_cle_api_mistral

# URL de base pour l'API Mistral (optionnel, par défaut: https://api.mistral.ai/v1)
LLM_BASE_URL=https://api.mistral.ai/v1

# URL pour les Agents API (optionnel, par défaut: https://api.mistral.ai/v1/agents)
MISTRAL_AGENTS_URL=https://api.mistral.ai/v1/agents

# URL pour les Conversations API (optionnel, par défaut: https://api.mistral.ai/v1/conversations)
MISTRAL_CONVERSATIONS_URL=https://api.mistral.ai/v1/conversations

# Modèle à utiliser (optionnel, par défaut: mistral-medium-latest)
MISTRAL_MODEL=mistral-medium-latest

# Configuration du serveur (optionnel)
SERVE_PORT=3000
SERVE_HOST=localhost
